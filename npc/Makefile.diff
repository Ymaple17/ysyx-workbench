
.PHONY: diff-save run-diff clean-diff


diff-save:
	@if [ ! -f "build/npc" ]; then echo "Error: build/npc not found. Run 'make' first."; exit 1; fi
	@echo "Saving current NPC as Golden Reference (npc-stable)..."
	@cp build/npc npc-stable
	@echo "Done."

run-diff:
	@if [ ! -f "npc-stable" ]; then echo "Error: npc-stable not found. Run 'make diff-save' first."; exit 1; fi
	@echo "Starting Golden Model Server..."
	@TRACE_DIFF_MODE=server ./npc-stable $(ARGS) & PID=$$!; \
	sleep 1; \
	echo "Starting DUT Client..."; \
	TRACE_DIFF_MODE=client $(call git_commit, "sim RTL") ./build/npc $(ARGS); \
	kill $$PID 2>/dev/null || true

clean-diff:
	rm -f npc-stable trace_diff.log /tmp/npc_trace_diff.sock
