mainmenu "NPC Configuration"

config BATCH_MODE
        bool "Enable Batch Execution (Disable Stepping)"
        default n

# 差分测试配置
config DIFFTEST
    bool "Enable difftest"
    default n

# 波形跟踪配置
config WAVEFORM
    bool "Enable waveform recording"
    default n

# 指令跟踪配置
config ITRACE
    bool "Enable instruction tracing"
    default n
    help
      Enable real-time tracing of executed instructions.

if ITRACE

config ITRACE_DETAIL
    bool "Enable detailed instruction tracing"
    default n
    help
      Include additional details in instruction trace output, such as register changes
      and operand values. Only effective when instruction tracing is enabled.

endif # ITRACE

config MTRACE
    bool "Enable memory tracing"
    default n

# 设备支持配置
config CONFIG_DEVICE
    tristate "Enable device support"
    default y

if CONFIG_DEVICE

config UART_ENABLE
    bool "Enable UART device"
    default y
    depends on CONFIG_DEVICE

config TIMER_ENABLE
    bool "Enable timer device"
    default y
    depends on CONFIG_DEVICE

config MMIO_DEBUG
    bool "Enable MMIO operation debugging"
    default n
    help
      Print detailed logs for memory-mapped I/O operations, including address, value and access type.
      Useful for debugging device interactions.
    depends on CONFIG_DEVICE

endif # CONFIG_DEVICE
