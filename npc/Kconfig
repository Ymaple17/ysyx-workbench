mainmenu "NPC Configuration"

# 差分测试配置
config DIFFTEST
    bool "open difftest"
    default n

if DIFFTEST

config DIFFTEST_PATH
    string "diff test path"
    default "/root/ysyx-workbench/nemu/build/riscv32-nemu-interpreter-so"
    depends on DIFFTEST

config ENABLE_MEMORY_CHECK
    bool "open memory check"
    default y
    depends on DIFFTEST

endif # DIFFTEST

# 波形跟踪配置
config WAVEFORM
    bool "open waveform"
    default n

if WAVEFORM

config WAVEFORM_FILE
    string "waveform file path"
    default "debug_wave.vcd"
    depends on WAVEFORM

endif # WAVEFORM

# 指令跟踪配置
config CONFIG_TRACE
    bool "open instruction trace"
    default n

# 设备支持配置
config CONFIG_DEVICE
    tristate "open device support"
    default y

if CONFIG_DEVICE

config UART_ENABLE
    bool "open UART"
    default y
    depends on CONFIG_DEVICE

config TIMER_ENABLE
    bool "open TIMER_ENABLE"
    default y
    depends on CONFIG_DEVICE

config MMIO_DEBUG
    bool "open MMIO debug "
    default n
    depends on CONFIG_DEVICE

endif # CONFIG_DEVICE

